  <script>
(function () {
  'use strict';
  if (!window.AD) return;
  var AD = window.AD, $ = AD.$, esc = AD.esc, money = AD.money;
  var KEYS = ['id', 'image', 'art_crop', 'set', 'collector_number', 'price', 'legal', 'pk'];
  var arr = function (x) { return Array.isArray(x) ? x : []; };
  var wait = function (ms) { return new Promise(function (r) { setTimeout(r, ms); }); };
  var isPk = function () { var d = AD.deck(); return d && d.game === 'pokemon'; };

  document.body.insertAdjacentHTML('beforeend',
    '<div class="modal-overlay" id="optModal"><div class="modal modal-large"><h3>💰 Price Optimiser</h3>' +
    '<div id="optStatus" style="font-size:13px"></div><div style="height:6px;background:var(--bg-base);border-radius:3px"><div id="optFill" style="height:100%;width:0;background:var(--cyan);border-radius:3px;transition:width .2s"></div></div>' +
    '<div id="optList" style="max-height:340px;overflow:auto;font-size:12px;display:flex;flex-direction:column;gap:4px"></div>' +
    '<div style="display:flex;justify-content:flex-end;gap:10px"><button type="button" class="danger" id="optUndo" style="display:none" data-action="opt-undo">↩ Undo All Swaps</button><button type="button" data-action="close-modal" data-modal="optModal">Close</button></div></div></div>' +
    '<div class="modal-overlay" id="bracketModal"><div class="modal modal-large"><div style="display:flex;justify-content:space-between;align-items:center"><h3>🏷️ Commander Bracket Estimate</h3><button type="button" data-action="close-modal" data-modal="bracketModal">✕</button></div>' +
    '<div id="brBody" style="max-height:70vh;overflow:auto;display:flex;flex-direction:column;gap:12px;font-size:13px"></div></div></div>');
  document.querySelector('#builderNavControls [data-action="export-deck"]').insertAdjacentHTML('beforebegin',
    '<button type="button" id="btnOpt" data-action="opt-run">💰 Optimise</button><button type="button" id="btnBracket" data-action="bracket-open">🏷️ Bracket</button>');

  // ================= PRICE OPTIMISER =================
  var busy = false, swaps = [];
  function isBasic(c) { return (c.pk && c.pk.basic) || /basic land/i.test(c.type); }
  function mtgCheapest(c) {
    return AD.sf('https://api.scryfall.com/cards/search?unique=prints&order=usd&dir=asc&q=' + encodeURIComponent('!"' + c.name + '"')).then(function (j) {
      var best = null; (j.data || []).forEach(function (p) { var n = AD.fromSf(p, c.qty); if (n.price > 0 && (!best || n.price < best.price)) best = n; }); return best;
    }).catch(function (e) { if (/404/.test(e.message)) return null; throw e; });
  }
  function runOpt() {
    var d = AD.deck(); if (!d) return;
    if (busy) { AD.openM('optModal'); return; }
    var cards = d.cards.filter(function (c) { return !c.locked && !isBasic(c) && c.price > 0; }), locked = d.cards.filter(function (c) { return c.locked; }).length;
    if (!cards.length) { AD.toast(d.cards.length ? 'Nothing to optimise (all locked, basic or unpriced).' : 'Deck is empty.'); return; }
    var pk = isPk(), i = 0, errs = 0; swaps = []; busy = true;
    $('optList').innerHTML = ''; $('optUndo').style.display = 'none'; $('optFill').style.width = '0'; AD.openM('optModal');
    function step() {
