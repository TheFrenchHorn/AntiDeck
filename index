    pane.innerHTML = '<div class="pop-bar" id="popBar"><div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap"><h2 style="font-size:22px;font-weight:800">🔥 Most Popular Commanders</h2>' +
      '<select id="popPeriod"><option value="week">Past week</option><option value="month">Past month</option><option value="year" selected>Past 2 years</option></select></div>' +
      '<div class="pop-search"><input type="text" id="popSearch" placeholder="Find decks for a commander (e.g. Atraxa)..." autocomplete="off"><div class="pop-sugs" id="popSugs"></div></div></div><div id="popBody"></div>';
    $('popPeriod').addEventListener('change', function (e) { period = e.target.value; loadTop(); });
    var inp = $('popSearch'), dd = $('popSugs'), qT;
    inp.addEventListener('input', function () {
      clearTimeout(qT); var q = inp.value.trim(); if (q.length < 2) { dd.style.display = 'none'; return; }
      qT = setTimeout(function () {
        var words = q.split(/\s+/).map(function (w) { return w.replace(/[^\w'-]/g, ''); }).filter(Boolean).map(function (w) { return 'name:' + w; }).join(' ');
        AD.sf('https://api.scryfall.com/cards/search?unique=cards&order=edhrec&q=' + encodeURIComponent('is:commander ' + words)).then(function (j) {
          sug = (j.data || []).slice(0, 8).map(function (p) { return AD.fromSf(p); });
          dd.innerHTML = sug.map(function (c, i) { return '<div class="pop-sug" data-action="pop-pick" data-i="' + i + '">' + esc(c.name) + '</div>'; }).join('') || '<div style="padding:10px 14px;color:var(--text-muted);font-size:12px">No commanders found</div>';
          dd.style.display = 'block';
        }).catch(function () { dd.style.display = 'none'; });
      }, 250);
    });
  }
  document.addEventListener('click', function (e) { var dd = $('popSugs'); if (dd && !e.target.closest('.pop-search')) dd.style.display = 'none'; });

  // ---------- top 100 grid ----------
  function loadTop() {
    view = 'grid'; $('popPeriod').style.display = ''; var body = $('popBody');
    if (top[period]) { renderGrid(); return; }
    body.innerHTML = msg('<span style="color:var(--cyan)">Loading the most popular commanders from EDHREC…</span>'); var my = ++run, pr = period;
    srv('getTopCommanders', pr).then(function (r) {
      if (!r || !r.ok) throw new Error((r && r.error) || 'No response.');
      return resolveNames(r.list.map(function (c) { return c.n; })).then(function (map) {
        var miss = r.list.filter(function (c) { return !lookup(map, c.n); }).reduce(function (a, c) { return a.concat(c.n.split(/ \/\/ | & /)); }, []);
        return (miss.length ? resolveNames(miss) : Promise.resolve({})).then(function (m2) { Object.keys(m2).forEach(function (k) { map[k] = m2[k]; }); top[pr] = { list: r.list, map: map }; });
      });
    }).then(function () { if (my === run && view === 'grid' && pr === period) renderGrid(); }).catch(function (e) { if (my === run) body.innerHTML = fail(e.message, 'pop-retry'); });
  }
  function renderGrid() {
    var t = top[period]; if (!t) return;
    $('popBody').innerHTML = '<div class="deck-grid">' + t.list.map(function (c, i) {
      var card = lookup(t.map, c.n), art = card ? card.art_crop : '';
      return '<div class="deck-tile" data-action="pop-open" data-i="' + i + '"><div class="deck-tile-art" style="background-image:url(\'' + esc(art) + '\')"><div class="deck-tile-art-gradient"></div><div class="deck-tile-format">#' + (i + 1) + '</div></div>' +
        '<div class="deck-tile-body"><div class="deck-tile-name" title="' + esc(c.n) + '">' + esc(c.n) + '</div><div class="deck-tile-meta"><span>' + dots(card ? card.color_identity : '') + '</span><span><strong>' + (c.d ? c.d.toLocaleString() : '—') + '</strong> decks</span></div></div></div>';
    }).join('') + '</div>';
  }

  // ---------- one commander's decks ----------
  function openCommander(sl, name, card) {
    view = 'detail'; $('popPeriod').style.display = 'none'; $('popSugs').style.display = 'none'; cur = { slug: sl, name: name, card: card, decks: null };
    var body = $('popBody'); body.innerHTML = msg('<span style="color:var(--cyan)">Loading decks for ' + esc(name) + '…</span>'); var my = ++run;
    srv('getCommanderDecks', sl).then(function (r) {
      if (my !== run) return; if (!r || !r.ok) throw new Error((r && r.error) || 'No response.');
      cur.decks = r.decks; cur.total = r.total || r.decks.length; renderDetail();
    }).catch(function (e) { if (my === run) body.innerHTML = '<div style="margin-bottom:10px"><button type="button" data-action="pop-back">← Back to top commanders</button></div>' + fail(e.message + ' (EDHREC may not have decks for this commander)', 'pop-back'); });
  }
  function renderDetail() {
    var c = cur.card;
    $('popBody').innerHTML = '<div style="margin-bottom:12px"><button type="button" data-action="pop-back">← Back to top commanders</button></div>' +
      '<div class="pop-head"><div class="pop-head-art" style="background-image:url(\'' + esc(c ? c.art_crop : '') + '\')"></div><div style="padding:10px 0"><div style="font-size:20px;font-weight:800">' + esc(cur.name) + '</div>' +
      '<div style="margin-top:6px;font-size:12px;color:var(--text-muted);display:flex;gap:10px;align-items:center">' + dots(c ? c.color_identity : '') + '<span>' + cur.decks.length + ' recent decks loaded</span>' +
      '<a class="cdm-link-btn" target="_blank" rel="noopener" href="https://edhrec.com/commanders/' + esc(cur.slug) + '">EDHREC ↗</a></div></div></div>' +
      '<div class="pop-bar" style="margin-bottom:12px"><div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap"><label style="font-size:12px;font-weight:700;color:var(--text-muted)">SORT</label>' +
      '<select id="popSort"><option value="pop">Most popular</option><option value="new">Newest first</option><option value="cheap">Cheapest first</option><option value="exp">Most expensive first</option></select>' +
      '<label style="font-size:12px;font-weight:700;color:var(--text-muted)">BUDGET</label><input type="number" id="popBudget" min="0" placeholder="Max price $" style="width:130px"></div></div><div id="popList"></div>';
    $('popSort').addEventListener('change', paintList); $('popBudget').addEventListener('input', paintList); paintList();
  }
  function paintList() {
    var sort = $('popSort').value, max = Number($('popBudget').value) || 0, d = cur.decks.slice();
    if (max) d = d.filter(function (x) { return x.p > 0 && x.p <= max; });
    var t = function (x) { var v = Date.parse(x.d); return isNaN(v) ? 0 : v; };
    if (sort === 'new') d.sort(function (a, b) { return t(b) - t(a); });
    else if (sort === 'cheap') d.sort(function (a, b) { return (a.p || 1e12) - (b.p || 1e12); });
    else if (sort === 'exp') d.sort(function (a, b) { return b.p - a.p; });
    else d.sort(function (a, b) { return a.i - b.i; });
    var n = d.length; d = d.slice(0, 20);
    $('popList').innerHTML = d.map(function (x) {
      return '<div class="pop-row"><div style="min-width:0;flex:1"><div style="font-weight:700;font-size:14px">' + esc(x.t || 'Untitled deck') + '</div>' +
        '<div style="font-size:12px;color:var(--text-muted);margin:4px 0">' + (x.p ? '<b style="color:var(--cyan)">' + money(x.p) + '</b>' : 'price n/a') + (x.d ? ' · ' + esc(x.d.slice(0, 10)) : '') + '</div>' +
        '<div style="display:flex;gap:5px;flex-wrap:wrap">' + x.g.map(function (g) { return '<span class="pop-chip">' + esc(g) + '</span>'; }).join('') + '</div></div>' +
        '<div style="display:flex;gap:6px;flex-wrap:wrap"><button type="button" data-action="pop-preview" data-h="' + esc(x.h) + '" data-t="' + esc(x.t) + '">👁 Preview</button><button type="button" class="cyan" data-action="pop-clone" data-h="' + esc(x.h) + '" data-t="' + esc(x.t) + '">➕ Clone</button>' +
        '<a class="cdm-link-btn" target="_blank" rel="noopener" href="https://edhrec.com/deckpreview/' + esc(x.h) + '">EDHREC ↗</a></div></div>';
    }).join('') + (d.length ? '<div style="font-size:11px;color:var(--text-muted);margin-top:6px">Showing ' + d.length + ' of ' + n + ' matching decks (from the ' + cur.decks.length + ' loaded).</div>' : '<div style="padding:30px;text-align:center;color:var(--text-muted)">No decks match that budget.</div>');
  }

  // ---------- deck contents, preview, clone ----------
  function getDeck(hash) {
    if (deckCache[hash]) return Promise.resolve(deckCache[hash]);
    return srv('getEdhrecDeck', hash).then(function (r) {
      if (!r || !r.ok) throw new Error((r && r.error) || 'Could not load that deck.');
      return resolveNames(r.cards.map(function (c) { return c.n; }).concat(r.commanders || [])).then(function (map) {
        var items = [], missing = [], have = {};
        r.cards.forEach(function (c) { var card = lookup(map, c.n); if (card) { items.push({ card: card, q: c.q }); have[norm(card.name)] = 1; } else missing.push(c.n); });
        (r.commanders || []).forEach(function (n) { var card = lookup(map, n); if (card && !have[norm(card.name)]) items.push({ card: card, q: 1 }); });
        var out = { items: items, missing: missing, cmds: (r.commanders || []).map(norm) }; deckCache[hash] = out; return out;
      });
    });
  }
  function isCmd(card, cmds) { var n = norm(card.name); return cmds.indexOf(n) >= 0 || cmds.indexOf(norm(n.split(' // ')[0])) >= 0; }
  function clone(hash, title) {
    AD.toast('Cloning deck…');
    getDeck(hash).then(function (g) {
      var cmds = g.cmds.length ? g.cmds : [norm(cur && cur.name)];
      var cards = g.items.map(function (it) { var c = AD.cc(JSON.parse(JSON.stringify(it.card))); c.qty = it.q; c.isCommander = isCmd(c, cmds); return c; });
      var deck = AD.cd({ name: (cur ? cur.name : 'Commander') + (title ? ' — ' + title : ' (EDHREC deck)'), format: 'Commander', game: 'mtg', cards: cards });
      S.decks.push(deck); S.activeDeckId = deck.id; AD.save(); tab = 'decks'; AD.render(); sync();
      AD.toast('Added “' + deck.name + '” to My Decks' + (g.missing.length ? ' — ' + g.missing.length + ' card(s) not found' : ''));
    }).catch(function (e) { AD.toast('Clone failed: ' + e.message); });
  }
  function showPreview(hash, title) {
    prev = { hash: hash, title: title }; $('popPrevTitle').textContent = (cur ? cur.name : 'Deck') + (title ? ' — ' + title : ''); $('popPrevSub').textContent = 'Loading cards…';
    $('popPrevLink').href = 'https://edhrec.com/deckpreview/' + hash; $('popPrevBody').innerHTML = msg('<span style="color:var(--cyan)">Fetching the decklist…</span>'); AD.openM('popPreviewModal');
    getDeck(hash).then(function (g) {
      if (!prev || prev.hash !== hash) return;
      var items = g.items.slice().sort(function (a, b) { var ca = isCmd(a.card, g.cmds) ? 0 : 1, cb = isCmd(b.card, g.cmds) ? 0 : 1; return ca - cb || a.card.cmc - b.card.cmc || a.card.name.localeCompare(b.card.name); });
      var total = items.reduce(function (s, it) { return s + it.q; }, 0), price = items.reduce(function (s, it) { return s + it.card.price * it.q; }, 0);
      $('popPrevSub').textContent = total + ' cards · est. ' + money(price) + (g.missing.length ? ' · ' + g.missing.length + ' not found' : '');
      $('popPrevBody').innerHTML = '<div class="pop-thumbs">' + items.map(function (it) {
        return '<div class="pop-thumb' + (isCmd(it.card, g.cmds) ? ' cmd' : '') + '" title="' + esc(it.card.name) + '"><img loading="lazy" src="' + esc(it.card.image) + '" alt="' + esc(it.card.name) + '">' + (it.q > 1 ? '<b>' + it.q + '×</b>' : '') + '</div>';
      }).join('') + '</div>';
    }).catch(function (e) { $('popPrevBody').innerHTML = fail(e.message, 'pop-close-prev'); $('popPrevSub').textContent = ''; });
  }

  // ---------- actions ----------
  AD.A['home-tab'] = function (b) { tab = b.dataset.tab; sync(); if (tab === 'pop' && !$('popBody')) { shell(); loadTop(); } };
  AD.A['pop-open'] = function (b) { var t = top[period], c = t && t.list[+b.dataset.i]; if (c) openCommander(c.s, c.n, lookup(t.map, c.n)); };
  AD.A['pop-pick'] = function (b) { var c = sug[+b.dataset.i]; if (!c) return; $('popSugs').style.display = 'none'; $('popSearch').value = ''; openCommander(slug(c.name), c.name, c); };
  AD.A['pop-back'] = function () { loadTop(); };
  AD.A['pop-retry'] = function () { loadTop(); };
  AD.A['pop-preview'] = function (b) { showPreview(b.dataset.h, b.dataset.t); };
  AD.A['pop-clone'] = function (b) { clone(b.dataset.h, b.dataset.t); };
  AD.A['pop-close-prev'] = function () { AD.closeM('popPreviewModal'); };
  AD.A['pop-clone-prev'] = function () { if (prev) { var p = prev; AD.closeM('popPreviewModal'); clone(p.hash, p.title); } };
  AD.home = { sync: sync };
  sync();
})();
</script>
</body>
</html>
