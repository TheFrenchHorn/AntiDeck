<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>AntiDeck | MTG Deck Builder</title>
  <style>
    :root {
      --bg-base: #0b0d12;
      --bg-surface: #121620;
      --bg-panel: #181d2a;
      --bg-card: #202738;
      --bg-card-hover: #293247;
      --border: #262f42;
      --border-light: #37435f;
      --text: #e6ebf5;
      --text-muted: #828fa8;
      --cyan: #00e5ff;
      --primary: #3b82f6;
      --primary-hover: #2563eb;
      --gold: #f59e0b;
      --danger: #ef4444;
      --success: #10b981;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background: var(--bg-base);
      color: var(--text);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      padding-bottom: 40px;
    }

    #errorBanner {
      display: none;
      background: #b91c1c;
      color: #fff;
      padding: 10px 16px;
      font-family: monospace;
      font-size: 13px;
      font-weight: bold;
      z-index: 9999;
    }

    header {
      background: var(--bg-surface);
      border-bottom: 1px solid var(--border);
      padding: 10px 20px;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      position: sticky;
      top: 0;
      z-index: 50;
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 8px;
      font-weight: 800;
      font-size: 19px;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: #fff;
      cursor: pointer;
      user-select: none;
    }
    .brand span { color: var(--cyan); text-shadow: 0 0 10px rgba(0, 229, 255, 0.4); }
    .nav-actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }

    select, button, input, textarea {
      font-family: inherit;
      border-radius: 6px;
      border: 1px solid var(--border);
      background: var(--bg-panel);
      color: var(--text);
      padding: 8px 12px;
      font-size: 13px;
      outline: none;
      transition: all 0.15s;
    }
    select:focus, input:focus, textarea:focus { border-color: var(--cyan); }
    button { font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; user-select: none; }
    button:hover { background: var(--bg-card); border-color: var(--border-light); }
    button.primary { background: var(--primary); border-color: var(--primary); color: #fff; }
    button.primary:hover { background: var(--primary-hover); }
    button.cyan { background: var(--cyan); border-color: var(--cyan); color: #000; }
    button.cyan:hover { background: #33ebff; }
    button.danger { color: var(--danger); }
    button.danger:hover { background: rgba(239, 68, 68, 0.15); border-color: var(--danger); }

    /* Home View */
    #viewHome { padding: 30px 24px; max-width: 1280px; margin: 0 auto; width: 100%; }
    .home-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; }
    .home-header h2 { font-size: 26px; font-weight: 800; }
    .deck-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 20px; }
    .deck-tile {
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: 10px;
      overflow: hidden;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      transition: transform 0.15s, border-color 0.15s, box-shadow 0.15s;
    }
    .deck-tile:hover { transform: translateY(-4px); border-color: var(--cyan); box-shadow: 0 10px 25px rgba(0,0,0,0.5); }
    .deck-tile-art { height: 140px; background-size: cover; background-position: center 25%; background-color: var(--bg-card); position: relative; }
    .deck-tile-art-gradient { position: absolute; inset: 0; background: linear-gradient(180deg, transparent 40%, var(--bg-surface) 100%); }
    .deck-tile-format {
      position: absolute; top: 10px; left: 10px; background: rgba(0,0,0,0.75); border: 1px solid var(--border);
      padding: 2px 8px; border-radius: 4px; font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--cyan);
    }
    .deck-tile-body { padding: 14px 16px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
    .deck-tile-name { font-size: 17px; font-weight: 700; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .deck-tile-meta { display: flex; justify-content: space-between; font-size: 12px; color: var(--text-muted); margin-top: auto; }
    .deck-tile-actions { display: flex; gap: 6px; padding: 8px 16px 12px; border-top: 1px solid rgba(255,255,255,0.04); justify-content: flex-end; }

    /* Builder View */
    #viewBuilder { display: none; flex-direction: column; flex: 1; }
    .deck-banner {
      background: var(--bg-surface);
      border-bottom: 1px solid var(--border);
      padding: 16px 20px;
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 20px;
      align-items: center;
    }
    .deck-info h1 { font-size: 24px; font-weight: 800; display: flex; align-items: center; gap: 12px; }
    .format-tag {
      font-size: 11px; font-weight: 800; text-transform: uppercase; padding: 3px 8px; border-radius: 4px;
      background: rgba(0, 229, 255, 0.12); color: var(--cyan); border: 1px solid rgba(0, 229, 255, 0.35);
    }
    .deck-meta { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 8px; font-size: 13px; color: var(--text-muted); }
    .deck-meta strong { color: var(--text); }
    .deck-visuals { display: flex; align-items: flex-end; gap: 16px; }
    .mana-curve { display: flex; align-items: flex-end; gap: 6px; height: 50px; }
    .curve-col { display: flex; flex-direction: column; align-items: center; gap: 4px; }
    .curve-bar { width: 15px; background: var(--cyan); border-radius: 2px 2px 0 0; min-height: 3px; transition: height 0.25s; }
    .curve-label { font-size: 10px; color: var(--text-muted); }

    .builder-search-strip {
      background: var(--bg-surface);
      border-bottom: 1px solid var(--border);
      padding: 12px 20px;
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }
    .search-wrapper { position: relative; max-width: 500px; width: 100%; flex: 1; }
    .search-input { width: 100%; padding: 10px 14px 10px 38px; font-size: 14px; background: var(--bg-base); border: 1px solid var(--border-light); border-radius: 8px; color: #fff; }
    .search-icon { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--text-muted); pointer-events: none; }
    .search-dropdown {
      position: absolute; top: 100%; left: 0; right: 0; margin-top: 6px;
      background: var(--bg-surface); border: 1px solid var(--border-light); border-radius: 8px;
      max-height: 340px; overflow-y: auto; z-index: 150; box-shadow: 0 14px 30px rgba(0,0,0,0.8); display: none;
    }
    .search-item { padding: 10px 14px; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid rgba(255,255,255,0.05); cursor: pointer; font-size: 13px; }
    .search-item:hover { background: var(--bg-card); color: var(--cyan); }
    .search-add-badge { font-size: 11px; color: var(--cyan); font-weight: 700; }

    /* Commander Zone */
    .commander-zone { margin: 20px 20px 0; background: var(--bg-surface); border: 1px solid var(--border); border-radius: 10px; padding: 16px 20px; display: flex; flex-direction: column; gap: 12px; }
    .commander-zone-header { display: flex; align-items: center; justify-content: space-between; font-size: 12px; font-weight: 800; text-transform: uppercase; color: var(--gold); }
    .commander-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; }
    .commander-hero-card { background: var(--bg-card); border: 1px solid var(--border-light); border-radius: 8px; overflow: hidden; display: flex; height: 105px; box-shadow: 0 4px 15px rgba(0,0,0,0.3); cursor: pointer; transition: border-color 0.15s; }
    .commander-hero-card:hover { border-color: var(--cyan); }
    .commander-hero-art { width: 140px; background-size: cover; background-position: center 25%; position: relative; flex-shrink: 0; }
    .commander-hero-art-gradient { position: absolute; inset: 0; background: linear-gradient(90deg, transparent 40%, var(--bg-card) 100%); }
    .commander-hero-info { padding: 10px 14px; display: flex; flex-direction: column; justify-content: space-between; flex: 1; overflow: hidden; }
    .commander-badge { font-size: 10px; font-weight: 800; padding: 2px 6px; border-radius: 3px; background: rgba(245, 158, 11, 0.15); color: var(--gold); border: 1px solid rgba(245, 158, 11, 0.3); width: fit-content; text-transform: uppercase; }
    .commander-hero-name { font-size: 14px; font-weight: 700; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

    /* Category Columns */
    .deck-board { flex: 1; padding: 20px; display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 16px; align-items: start; }
    .category-column { background: var(--bg-surface); border: 1px solid var(--border); border-radius: 8px; overflow: hidden; display: flex; flex-direction: column; }
    .column-header { background: rgba(255,255,255,0.03); padding: 10px 14px; font-size: 12px; font-weight: 700; text-transform: uppercase; color: var(--text-muted); border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; }
    .column-badge { background: var(--bg-card); padding: 2px 8px; border-radius: 10px; font-size: 11px; color: var(--text); }

    /* Card Slices */
    .card-slice { position: relative; display: flex; align-items: center; justify-content: space-between; padding: 8px 12px; border-bottom: 1px solid rgba(255,255,255,0.03); background-color: var(--bg-card); user-select: none; cursor: pointer; transition: background 0.12s; }
    .card-slice:hover { filter: brightness(1.15); }
    .card-slice-bg { position: absolute; inset: 0; background-size: cover; background-position: right 25%; opacity: 0.35; pointer-events: none; }
    .card-slice-gradient { position: absolute; inset: 0; background: linear-gradient(90deg, var(--bg-card) 45%, rgba(32, 39, 56, 0.4) 100%); pointer-events: none; }
    .card-slice-left { position: relative; display: flex; align-items: center; gap: 8px; z-index: 1; max-width: 60%; }
    .card-slice-right { position: relative; display: flex; align-items: center; gap: 6px; z-index: 1; }
    .card-name-text { font-size: 13px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .card-slice:hover .card-name-text { color: var(--cyan); }
    .qty-badge { font-size: 12px; font-weight: 800; color: var(--cyan); min-width: 16px; text-align: right; }
    .card-cost { font-size: 11px; color: #fbbf24; font-family: monospace; }
    .card-price { font-size: 11px; color: var(--text-muted); }
    .icon-btn { padding: 2px 6px; font-size: 11px; border-radius: 4px; background: var(--bg-panel); border: 1px solid var(--border-light); color: #fff; cursor: pointer; }
    .icon-btn.is-commander { color: var(--gold); border-color: var(--gold); }

    /* Visual Grid */
    .visual-card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 12px; padding: 12px; }
    .visual-card-item { position: relative; border-radius: 8px; overflow: hidden; border: 1px solid var(--border); background: var(--bg-card); aspect-ratio: 488 / 680; cursor: pointer; transition: transform 0.15s, border-color 0.15s; }
    .visual-card-item:hover { transform: translateY(-3px); border-color: var(--cyan); box-shadow: 0 8px 20px rgba(0,0,0,0.6); }
    .visual-card-img { width: 100%; height: 100%; object-fit: contain; display: block; background: #0b0d12; pointer-events: none; }
    .visual-card-overlay { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,0.7) 0%, transparent 40%, rgba(0,0,0,0.85) 100%); display: flex; flex-direction: column; justify-content: space-between; padding: 6px; pointer-events: none; }
    .visual-card-overlay button { pointer-events: auto; }

    #cardPreview {
      position: fixed; display: none; width: 250px; pointer-events: none; z-index: 1000;
      border-radius: 12px; box-shadow: 0 14px 40px rgba(0,0,0,0.85);
      aspect-ratio: 488 / 680; object-fit: contain; background: #000;
    }

    /* Modal Architecture */
    .modal-overlay {
      position: fixed; inset: 0; background: rgba(0,0,0,0.82); backdrop-filter: blur(4px);
      display: none; pointer-events: none; visibility: hidden; opacity: 0;
      align-items: center; justify-content: center; padding: 20px; z-index: 200;
      transition: opacity 0.15s ease;
    }
    .modal-overlay.active { display: flex !important; pointer-events: auto !important; visibility: visible !important; opacity: 1 !important; }
    .modal { background: var(--bg-surface); border: 1px solid var(--border); border-radius: 10px; width: 100%; max-width: 540px; padding: 24px; display: flex; flex-direction: column; gap: 16px; box-shadow: 0 20px 40px rgba(0,0,0,0.6); }
    .modal.modal-large { max-width: 820px; }
    .modal.modal-full { max-width: 1240px; width: 95vw; height: 90vh; max-height: 90vh; }

    /* Archidekt Card Detail Modal */
    #cardDetailModal.modal-overlay { z-index: 500; background: rgba(4, 7, 12, 0.88); backdrop-filter: blur(8px); }
    #artModal.modal-overlay { z-index: 700; }
    .cdm-shell {
      background: #11151f; border: 1px solid var(--border-light); border-radius: 12px;
      width: 95vw; max-width: 1050px; max-height: 90vh; display: flex; flex-direction: column;
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.85); overflow: hidden;
    }
    .cdm-header {
      background: #151b27; border-bottom: 1px solid var(--border); padding: 12px 18px;
      display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap;
    }
    .cdm-header-left { display: flex; align-items: center; gap: 12px; }
    .cdm-title-area { display: flex; flex-direction: column; }
    .cdm-title { font-size: 19px; font-weight: 800; color: #fff; }
    .cdm-subtitle { font-size: 11px; color: var(--text-muted); }
    .cdm-tabs { display: flex; gap: 4px; background: rgba(0,0,0,0.3); padding: 3px; border-radius: 6px; }
    .cdm-tab {
      padding: 6px 12px; font-size: 12px; font-weight: 700; color: var(--text-muted);
      background: transparent; border: none; border-radius: 4px; cursor: pointer;
    }
    .cdm-tab:hover { color: #fff; background: rgba(255,255,255,0.05); }
    .cdm-tab.active { color: #fff; background: var(--bg-card); border-bottom: 2px solid var(--cyan); }
    .cdm-header-links { display: flex; align-items: center; gap: 8px; }
    .cdm-link-btn {
      font-size: 11px; font-weight: 600; padding: 6px 10px; border-radius: 5px;
      border: 1px solid var(--border-light); background: rgba(255,255,255,0.04);
      color: var(--text); text-decoration: none; display: inline-flex; align-items: center; gap: 5px;
    }
    .cdm-link-btn:hover { border-color: var(--cyan); color: var(--cyan); }

    .cdm-body { display: grid; grid-template-columns: 290px 1fr; gap: 20px; padding: 20px; overflow-y: auto; flex: 1; }
    @media (max-width: 820px) { .cdm-body { grid-template-columns: 1fr; } }
    .cdm-left-pane { display: flex; flex-direction: column; gap: 12px; align-items: center; }
    .cdm-card-image-wrap {
      width: 100%; max-width: 270px; aspect-ratio: 488 / 680; border-radius: 10px;
      overflow: hidden; box-shadow: 0 10px 30px rgba(0,0,0,0.7); background: #080a0f;
      position: relative; border: 1px solid var(--border);
    }
    .cdm-card-image { width: 100%; height: 100%; object-fit: contain; display: block; }
    .cdm-flip-btn {
      position: absolute; bottom: 8px; right: 8px; background: rgba(0,0,0,0.8);
      border: 1px solid var(--cyan); color: var(--cyan); font-size: 11px; padding: 4px 8px;
      border-radius: 4px; display: none; cursor: pointer;
    }
    .cdm-prices-row { display: flex; gap: 10px; font-size: 12px; font-weight: 700; }
    .cdm-price-pill { padding: 4px 10px; background: rgba(0, 229, 255, 0.08); border: 1px solid rgba(0, 229, 255, 0.25); color: var(--cyan); border-radius: 6px; }
    .cdm-nav-steppers { display: flex; gap: 8px; width: 100%; max-width: 270px; }
    .cdm-nav-steppers button { flex: 1; font-size: 11px; justify-content: center; padding: 6px; }

    .cdm-right-pane { display: flex; flex-direction: column; gap: 16px; }
    .cdm-panel { display: none; }
    .cdm-panel.active { display: flex; flex-direction: column; gap: 16px; }
    .cdm-options-grid { display: grid; grid-template-columns: 1.2fr 1fr; gap: 16px; }
    @media (max-width: 640px) { .cdm-options-grid { grid-template-columns: 1fr; } }
    .cdm-group-box { background: rgba(255,255,255,0.02); border: 1px solid var(--border); border-radius: 8px; padding: 14px; display: flex; flex-direction: column; gap: 12px; }
    .cdm-group-title { font-size: 11px; font-weight: 800; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.5px; }
    .cdm-stepper-qty { display: flex; align-items: center; gap: 6px; }
    .cdm-stepper-qty input { width: 55px; text-align: center; font-weight: 700; font-size: 14px; }
    .cdm-print-info { display: flex; flex-direction: column; gap: 6px; background: var(--bg-surface); padding: 10px; border-radius: 6px; border: 1px solid var(--border); }
    .cdm-action-list { display: flex; flex-direction: column; gap: 8px; }
    .cdm-action-list button { justify-content: flex-start; padding: 8px 12px; font-size: 12px; }

    .cdm-info-grid { display: flex; flex-direction: column; gap: 10px; background: var(--bg-surface); border: 1px solid var(--border); padding: 14px; border-radius: 8px; }
    .cdm-info-row { font-size: 13px; display: flex; justify-content: space-between; border-bottom: 1px solid rgba(255,255,255,0.04); padding-bottom: 6px; }
    .cdm-info-row strong { color: var(--text-muted); font-size: 11px; text-transform: uppercase; }
    .cdm-oracle-preview { font-size: 13px; line-height: 1.5; background: rgba(0,0,0,0.3); padding: 10px; border-radius: 6px; white-space: pre-wrap; border-left: 3px solid var(--cyan); }
    .cdm-rulings-list { display: flex; flex-direction: column; gap: 10px; max-height: 400px; overflow-y: auto; }
    .cdm-ruling-item { background: var(--bg-surface); border: 1px solid var(--border); border-radius: 6px; padding: 10px 12px; font-size: 12px; line-height: 1.45; }
    .cdm-ruling-date { font-size: 10px; font-weight: 800; color: var(--cyan); margin-bottom: 4px; }

    /* Advanced Search */
    .adv-search-layout { display: grid; grid-template-columns: 320px 1fr; gap: 20px; height: calc(90vh - 110px); overflow: hidden; }
    @media (max-width: 860px) { .adv-search-layout { grid-template-columns: 1fr; overflow-y: auto; height: auto; } }
    .adv-search-filters { background: var(--bg-panel); border: 1px solid var(--border); border-radius: 8px; padding: 16px; overflow-y: auto; display: flex; flex-direction: column; gap: 13px; }
    .adv-group { display: flex; flex-direction: column; gap: 5px; }
    .adv-group label { font-size: 11px; font-weight: 800; text-transform: uppercase; color: var(--text-muted); display: flex; justify-content: space-between; align-items: center; }
    .adv-group input, .adv-group select { width: 100%; }
    .oracle-box { border: 1px solid var(--cyan); background: rgba(0, 229, 255, 0.04); padding: 10px; border-radius: 6px; display: flex; flex-direction: column; gap: 6px; }
    .oracle-box label { color: var(--cyan); font-weight: 800; font-size: 11px; text-transform: uppercase; }
    .color-pills-row { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; margin-top: 2px; }
    .color-pill { width: 32px; height: 32px; border-radius: 50%; border: 2px solid var(--border-light); display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 13px; cursor: pointer; user-select: none; transition: transform 0.15s, border-color 0.15s; }
    .color-pill:hover { transform: scale(1.1); }
    .color-pill.active { border-color: #fff; box-shadow: 0 0 10px rgba(255,255,255,0.4); }
    .color-pill[data-color="W"] { background: #fdfce8; color: #222; }
    .color-pill[data-color="U"] { background: #0077c8; color: #fff; }
    .color-pill[data-color="B"] { background: #262428; color: #fff; border-color: #555; }
    .color-pill[data-color="R"] { background: #d3202a; color: #fff; }
    .color-pill[data-color="G"] { background: #00733e; color: #fff; }
    .color-pill[data-color="C"] { background: #7c8594; color: #fff; }
    .rarity-checkboxes { display: flex; gap: 8px; flex-wrap: wrap; font-size: 12px; }
    .rarity-checkboxes label { display: flex; align-items: center; gap: 4px; cursor: pointer; color: var(--text); }
    .adv-search-results-pane { display: flex; flex-direction: column; height: 100%; overflow: hidden; }
    .adv-results-header { display: flex; justify-content: space-between; align-items: center; padding-bottom: 12px; border-bottom: 1px solid var(--border); margin-bottom: 12px; gap: 10px; flex-wrap: wrap; }
    .adv-results-grid { flex: 1; overflow-y: auto; display: grid; grid-template-columns: repeat(auto-fill, minmax(185px, 1fr)); gap: 16px; padding-right: 6px; align-content: start; }
    .adv-card-item { background: var(--bg-card); border: 1px solid var(--border); border-radius: 10px; overflow: hidden; display: flex; flex-direction: column; position: relative; min-height: 330px; box-sizing: border-box; transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease; }
    .adv-card-item:hover { transform: translateY(-4px); border-color: var(--cyan); box-shadow: 0 10px 24px rgba(0,0,0,0.6); }
    .adv-card-art-wrap { width: 100%; height: 255px; min-height: 250px; aspect-ratio: 488 / 680; background: #080a0f; flex-shrink: 0; position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center; }
    .adv-card-art { width: 100%; height: 100%; object-fit: contain; display: block; transition: transform 0.2s ease; background: #0d1117; }
    .adv-card-art.crop-mode { object-fit: cover; }
    .adv-card-item:hover .adv-card-art { transform: scale(1.03); }
    .adv-card-info { padding: 10px; display: flex; flex-direction: column; gap: 5px; flex: 1; justify-content: space-between; background: var(--bg-card); border-top: 1px solid var(--border); min-height: 75px; }
