  A['pk-reset'] = function () { document.querySelectorAll('#pkSearchModal input[type=text]').forEach(function (i) { i.value = ''; }); document.querySelectorAll('#pkSearchModal select').forEach(function (s) { s.value = ''; }); $('pkLegal').checked = false; };
  A['pk-info'] = function (b) { openCard(b.dataset.id, true); };
