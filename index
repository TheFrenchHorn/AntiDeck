      return (pk ? AD.pk.cheapest(c) : mtgCheapest(c)).then(function (n) {
        if (n && n.price < c.price - 0.005) { var b = {}; KEYS.forEach(function (k) { b[k] = c[k]; }); KEYS.forEach(function (k) { c[k] = n[k]; }); swaps.push({ c: c, before: b, after: n }); }
      }).catch(function () { errs++; }).then(function () { return wait(pk ? 30 : 110); }).then(step);
