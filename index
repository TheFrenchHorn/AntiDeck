  AD.pk = { resolve: function (n) { return newestLegal(n).then(function (d) { return fromDex(d, 1); }); }, add: add, cheapest: cheapest, suggest: suggest, quickAdd: quickAdd, afterRender: afterRender, exportText: exportText };
