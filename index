  }

  // ---------- price optimiser support: cheapest identical reprint ----------
  function sig(p) {
    p = p || {};
    return JSON.stringify([p.hp, p.types, p.stage, (p.attacks || []).map(function (a) { return [a.name, (a.cost || []).join(), a.damage, a.effect]; }), (p.abilities || []).map(function (a) { return [a.name, a.effect]; }), p.effect, p.retreat, (p.weaknesses || []).map(function (w) { return w.type + w.value; })]);
  }
  function cheapest(c) {
