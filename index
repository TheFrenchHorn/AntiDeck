  // ---------- wire into the app ----------
  function wrap(k, f) { var o = AD.A[k]; AD.A[k] = function (b, e) { var d = AD.deck(); return (d && d.game === 'pokemon') ? f(b, e, o) : (o && o(b, e)); }; }
